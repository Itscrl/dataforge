# Server variables. Never put provider keys in VITE_ variables or source code.
APP_ORIGIN=http://localhost:5173
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8787
LLAMA_PROVIDER=ollama
LLAMA_BASE_URL=http://127.0.0.1:11434
LLAMA_MODEL=llama3.1:8b
# Hosted OpenAI-compatible endpoint: LLAMA_PROVIDER=compatible
# LLAMA_BASE_URL=https://your-provider.example/v1
# LLAMA_API_KEY=
# TUTOR_ACCESS_TOKEN=required-if-binding-non-loopback
